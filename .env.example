# Copy to .env and fill in. Never commit .env.
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
# Optional overrides
ASSEMBLYAI_MODEL=
DEEPGRAM_MODEL=
# Optional comma-separated keyterms (names, jargon); billed as an add-on by both providers
ASSEMBLYAI_KEYTERMS=
DEEPGRAM_KEYTERMS=
# Step 4 web research (Tavily)
TAVILY_API_KEY=
# Optional cap on cited facts per claim (default 5)
RESEARCH_MAX_FACTS=
# Live microphone token server. The page never sees DEEPGRAM_API_KEY.
# MIC_PORT=8787
# MIC_HOST=127.0.0.1
# MIC_ALLOWED_ORIGINS=https://marvelus-tech.github.io
