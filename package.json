{
  "name": "contxt-replay-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "contxt-replay": "./dist/harness/cli.js",
    "contxt-transcribe": "./dist/harness/transcribe.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "replay": "npm run build && node dist/harness/cli.js",
    "ci:replay": "npm run replay -- --fixture samples/demo.json --speed 1000",
    "transcribe": "npm run build && node dist/harness/transcribe.js",
    "ci:debate": "npm run replay -- --fixture samples/debate1992.json --speed 1000",
    "eval:claims": "npm run build && node bakeoff/eval_claims.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3"
  }
}
