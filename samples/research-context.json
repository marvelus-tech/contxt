    {
      "id": "federal-debt",
      "keywords": [
        "trillion",
        "debt",
        "deficit",
        "national debt"
      ],
      "facts": [
        {
          "text": "Gross federal debt was about $4 trillion during 1992.",
          "sourceUrl": "https://fred.stlouisfed.org/series/GFDEBTN"
        },
        {
          "text": "Treasury publishes historical debt to the penny and related fiscal series.",
          "sourceUrl": "https://fiscaldata.treasury.gov/datasets/debt-to-the-penny/debt-to-the-penny"
        },
        {
          "text": "Ross Perot raised the debt as a central 1992 debate issue.",
          "sourceUrl": "https://www.debates.org/voter-education/debate-transcripts/october-11-1992-first-half-debate-transcript/"
        }
      ]
    },
    {
      "id": "jobs-wages",
      "keywords": [
        "jobs",
        "job growth",
        "wages",
        "unemploy",
        "bankrupt",
        "poverty",
        "income growth"
      ],
      "facts": [
        {
          "text": "The U.S. unemployment rate peaked near 7.8 percent in June 1992.",
          "sourceUrl": "https://fred.stlouisfed.org/series/UNRATE"
        },
        {
          "text": "BLS publishes national and state employment and wage statistics.",
          "sourceUrl": "https://www.bls.gov/data/"
        },
        {
          "text": "Census Bureau poverty and income tables cover the early 1990s.",
          "sourceUrl": "https://www.census.gov/topics/income-poverty/poverty.html"
        }
      ]
    },
